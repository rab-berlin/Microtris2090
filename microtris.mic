; microtris-08.mic - Tetris für Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio) und 4 Tastern
; 255 Schritte (00-FE), frei: 1
; Version 06: Matrix des ESP2090 Studios. Zwischen den Bildern schlaeft sie (ACK 15, kein REQ), damit Eingang 1
;   Taster links sein kann; vor dem Bild weckt F, dann folgt ACK 1. Die Taster werden im Befehl
;   zwischen ACK und erstem Wert gelesen. Kolli faellt in Rand (1 Schritt gespart).
; Version 07: nach dem Wecken auf REQ warten statt ACK 1 blind zu senden (+2). Dafuer faellt Neu in Fertig
;   und Los in Zug (der Zug-Block steht jetzt hinter Los): 2 GOTO weniger.
; Version 08: Wecken als Handshake. Das F bleibt stehen, bis der ESP mit REQ antwortet, dann folgt direkt
;   ACK 1 (keine 0 dazwischen). So geht kein Wecken verloren, egal wie spaet der ESP nachsieht.
;   Schlafen steht jetzt direkt hinter dem Bild (kein Unterprogramm), am Start entfaellt es.
; Start: Reset, Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), RUN.
;   Alle Register müssen 0 sein. Matrix vergessen? Das Programm wartet am Anfang ohne Bild: Matrix einschalten.
; Tempo aus den gelöschten Reihen: der Stein fällt alle 5 - Reihen/4 Durchläufe,
;   0-3 Reihen 2,5 s je Reihe, 4-7 2,1 s, 8-11 1,75 s, 12-15 1,4 s, ab 16 jeden Durchlauf 1,0 s.
; Taster 1 (Pfeil links) = links, 4 (Pfeil rechts) = rechts,
;   2 (Pfeil hoch) = rechts drehen, 3 (Pfeil runter) = links drehen.
;   Nur neu gedrückte Taster zählen (einmal drücken = ein Schritt), mehrere: der niedrigste zählt.
; Schacht: Spalte 1-4, Reihe 1-8. Vorschau: der nächste Stein in Spalte 6-7, Reihe 7-8 (MD, MF).
;   Er fährt in Spalte 2-3 von oben ein: erst steht nur seine untere Zeile in Reihe 8 (ME),
;   die obere ist noch über dem Feld; beim nächsten Fallen ist er ganz drin.
; Formen im 2x2-Kasten: Ecke (1/2), Zweier (1/4), Quadrat (1/4), zufällig gedreht.
; Volle Reihen 1-7 verschwinden. Spielende, wenn nach dem Landen etwas in Reihe 8 liegt:
;   Anzeige = gelöschte Reihen dezimal. Neues Spiel: Reset.
; Zeiten: Durchlauf ohne Taste 0,38 s, Fallen +0,6 s, Zug oder Drehen +0,6 bis 0,9 s.
; Die Matrix ist nur für das Bild wach, sonst schlaeft sie: Eingang 1 ist dann Taster links.
;
; Feld: R0-R7 = Reihe 1-8 (unten nach oben), Bit 1 = Spalte 1 (links). Der Stein ist im Feld eingezeichnet.
; Zwei Kontexte in R8-RF, Wechsel mit EXRM (der andere liegt in M8-MF).
; AKT wird mit MAS übergeben; die neue Vorschau kommt per MAS UNTEN, MAS OBEN direkt nach VOR_U, VOR_O,
;   die alte obere Vorschauzeile per MAS VOR_O nach OBEN.
;
; #define (Register)
;   FORM      r8  Kontext A: Form im 2x2-Kasten, Bit 1 oben links, 2 oben rechts, 4 unten rechts, 8 unten links
;   SPALTE    r9  Kontext A: Kasten-Spalte 0-4 (linke Kastenspalte = Spalte SPALTE, 0 = über den linken Rand)
;   ZEILE     rA  Kontext A: obere Kastenzeile als Register 0-7 (untere = ZEILE-1; F und 8-E = unter dem Boden)
;   UNTEN     rB  Kontext A: Maske untere Kastenzeile (Spalte 1-4 = Bit 1-4)
;   OBEN      rC  Kontext A: Maske obere Kastenzeile
;   MASKE     rD  Kontext A: Hilfsregister: Summand für Zug, Vereinigung in Masken, RND-Ziffer D
;   ALT       rE  Kontext A: Hilfsregister: alte Zeile aus Zug, Zähler in Masken, RND-Ziffer E
;   AKT       rF  beide Kontexte: Aktion 0 hoch, 1 links, 2 rechts drehen, 3 links drehen, 4 rechts, 5 fallen
;   TASTE     r8  Kontext B: Taster bei der letzten Abfrage
;   ZAEHL     r9  Kontext B: Fallzähler, Unterlauf = fallen
;   HILF      rA  Kontext B: Hilfsregister: Matrix (Bereit, Start, Umschalten), neue Taster, Prüfung
;   VOR_U     rB  Kontext B: Vorschau = untere Zeile des nächsten Steins (Bit 2-4), gleiche Nummer wie UNTEN
;   VOR_O     rC  Kontext B: Vorschau = obere Zeile des nächsten Steins, gleiche Nummer wie OBEN
;   REIHEN_L  rD  Kontext B: gelöschte Reihen, Einer (hex)
;   REIHEN_H  rE  Kontext B: gelöschte Reihen, Sechzehner

F02   ; 00  Beginn   DISOUT                   Anzeige aus: 9,3 ms je Befehl (Takt der Matrix)

9F0   ; 01  Voll     CMPI    #F,r0            Reihe 1 voll?
E14   ; 02           BRZ     Weg0
9F1   ; 03           CMPI    #F,r1
E15   ; 04           BRZ     Weg1
9F2   ; 05           CMPI    #F,r2
E16   ; 06           BRZ     Weg2
9F3   ; 07           CMPI    #F,r3
E17   ; 08           BRZ     Weg3
9F4   ; 09           CMPI    #F,r4
E18   ; 0A           BRZ     Weg4
9F5   ; 0B           CMPI    #F,r5
E19   ; 0C           BRZ     Weg5
9F6   ; 0D           CMPI    #F,r6
E1A   ; 0E           BRZ     Weg6

077   ; 0F  Pruef    MOV     r7,r7            Reihe 8 leer? sonst Spielende
E20   ; 10           BRZ     Neu

F03   ; 11  Ende     HXDZ                     Spielende: gelöschte Reihen dezimal (AKT = F ist 0: gelandet)
F3D   ; 12           DISP    #3,REIHEN_L

C13   ; 13  Halt     GOTO    Halt             bleibt stehen (neues Spiel: Reset)

010   ; 14  Weg0     MOV     r1,r0            Reihe löschen: alles darüber eine Reihe tiefer

021   ; 15  Weg1     MOV     r2,r1

032   ; 16  Weg2     MOV     r3,r2

043   ; 17  Weg3     MOV     r4,r3

054   ; 18  Weg4     MOV     r5,r4

065   ; 19  Weg5     MOV     r6,r5

076   ; 1A  Weg6     MOV     r7,r6

107   ; 1B  Weg7     MOVI    #0,r7
51D   ; 1C           ADDI    #1,REIHEN_L      Reihen zählen
FBE   ; 1D           ADC     REIHEN_H
C01   ; 1E           GOTO    Voll             weitere volle Reihe?

F0E   ; 1F  Neu0     EXRM                     Spielbeginn: Kontext B, noch einmal

F7C   ; 20  Neu      MAS     VOR_O            obere Vorschauzeile nach MC = OBEN im Kontext A
4B7   ; 21           ADD     VOR_U,r7         untere Vorschauzeile in Reihe 8, Spalte 2-3 (Reihe 8 ist leer)
F0E   ; 22           EXRM                     Kontext A
0CA   ; 23           MOV     OBEN,ZEILE       obere Zeile merken (ZEILE ist frei)
F05   ; 24           RND                      Würfel in MASKE, ALT, AKT
178   ; 25           MOVI    #7,FORM          Ecke (1/2)
F9D   ; 26           SHR     MASKE
D2C   ; 27           BRC     Dreh
138   ; 28           MOVI    #3,FORM          Zweier (1/4)
F9D   ; 29           SHR     MASKE
D2C   ; 2A           BRC     Dreh
1F8   ; 2B           MOVI    #F,FORM          Quadrat (1/4)

33E   ; 2C  Dreh     ANDI    #3,ALT           zufällig 0-3 mal drehen

71E   ; 2D  DrL      SUBI    #1,ALT
D32   ; 2E           BRC     DrE
FA8   ; 2F           SHL     FORM
FB8   ; 30           ADC     FORM
C2D   ; 31           GOTO    DrL

129   ; 32  DrE      MOVI    #2,SPALTE        Masken in Spalte 2-3 = neue Vorschau
BAA   ; 33           CALL    Masken
F7B   ; 34           MAS     UNTEN            nach MB = VOR_U im Kontext B
F7C   ; 35           MAS     OBEN             nach MC = VOR_O
07B   ; 36           MOV     r7,UNTEN         aktueller Stein = alte Vorschau
0AC   ; 37           MOV     ZEILE,OBEN
0C8   ; 38           MOV     OBEN,FORM        FORM aus den Masken: oben Bit 2/4 -> 1/2
F98   ; 39           SHR     FORM
0BD   ; 3A           MOV     UNTEN,MASKE      unten rechts (Bit 4) -> 4
34D   ; 3B           ANDI    #4,MASKE
AD8   ; 3C           OR      MASKE,FORM
0BD   ; 3D           MOV     UNTEN,MASKE      unten links (Bit 2) -> 8
FAD   ; 3E           SHL     MASKE
FAD   ; 3F           SHL     MASKE
AD8   ; 40           OR      MASKE,FORM
E1F   ; 41           BRZ     Neu0             leer: Spielbeginn ohne Vorschau
18A   ; 42           MOVI    #8,ZEILE         obere Kastenzeile über Reihe 8 (unsichtbar)
15F   ; 43           MOVI    #5,AKT           nicht 0 (0 = gelandet); untere Zeile steht schon im Feld

F7F   ; 44  Fertig   MAS     AKT              AKT über MF in den Kontext B
F0E   ; 45           EXRM                     Kontext B
0FF   ; 46           MOV     AKT,AKT          0 = Fallen wurde zurückgenommen: gelandet
E01   ; 47           BRZ     Voll

719   ; 48  Grav     SUBI    #1,ZAEHL         Fallzähler (auch direkt nach dem Fallen): bei Unterlauf fallen
D74   ; 49           BRC     Fall

10A   ; 4A  Bild     MOVI    #0,HILF          HILF = 0 fuer die rechten Haelften und das Ende
1FF   ; 4B           MOVI    #F,AKT           Matrix wecken: F anlegen und halten ...
FEF   ; 4C           DOT     AKT

FDF   ; 4D  BW       DIN     AKT              ... bis der ESP mit REQ antwortet (danach = 1 = ACK)
31F   ; 4E           ANDI    #1,AKT
E4D   ; 4F           BRZ     BW
FEF   ; 50           DOT     AKT              ACK 1 direkt nach dem F
FDF   ; 51           DIN     AKT              Taster: der eine Befehl zwischen ACK und erstem Wert (REQ ist jetzt Low)
FE0   ; 52           DOT     r0               Reihe 1 links
FEA   ; 53           DOT     HILF             Reihe 1 rechts: dunkel
FE1   ; 54           DOT     r1               Reihe 2 links
FEA   ; 55           DOT     HILF             Reihe 2 rechts: dunkel
FE2   ; 56           DOT     r2               Reihe 3 links
FEA   ; 57           DOT     HILF             Reihe 3 rechts: dunkel
FE3   ; 58           DOT     r3               Reihe 4 links
FEA   ; 59           DOT     HILF             Reihe 4 rechts: dunkel
FE4   ; 5A           DOT     r4               Reihe 5 links
FEA   ; 5B           DOT     HILF             Reihe 5 rechts: dunkel
FE5   ; 5C           DOT     r5               Reihe 6 links
FEA   ; 5D           DOT     HILF             Reihe 6 rechts: dunkel
FE6   ; 5E           DOT     r6               Reihe 7 links
FEB   ; 5F           DOT     VOR_U            Reihe 7 rechts: Vorschau unten
FE7   ; 60           DOT     r7               Reihe 8 links
FEC   ; 61           DOT     VOR_O            Reihe 8 rechts: Vorschau oben
FEA   ; 62           DOT     HILF             Ausgaenge 0: Uebertragung fertig
FDA   ; 63  Schlaf   DIN     HILF             Matrix schlafen legen: auf REQ warten ...
31A   ; 64           ANDI    #1,HILF
E63   ; 65           BRZ     Schlaf
1FA   ; 66           MOVI    #F,HILF          ... ACK 15 (schlafen)
FEA   ; 67           DOT     HILF
10A   ; 68           MOVI    #0,HILF          nach 2 Schritten wegnehmen (laenger als 40 ms waere Wecken)
FEA   ; 69           DOT     HILF
08A   ; 6A           MOV     TASTE,HILF       nur neu gedrückte Taster zählen
F8A   ; 6B           INV     HILF
0F8   ; 6C           MOV     AKT,TASTE
2FA   ; 6D           AND     AKT,HILF
E48   ; 6E           BRZ     Grav
10F   ; 6F           MOVI    #0,AKT           AKT = Nummer des niedrigsten neuen Tasters

51F   ; 70  TNr      ADDI    #1,AKT
F9A   ; 71           SHR     HILF
D7D   ; 72           BRC     Los
C70   ; 73           GOTO    TNr

119   ; 74  Fall     MOVI    #1,ZAEHL         Tempo: ab 16 Reihen jeden Durchlauf fallen ...
90E   ; 75           CMPI    #0,REIHEN_H
D7C   ; 76           BRC     FallA
0D9   ; 77           MOV     REIHEN_L,ZAEHL   ... sonst alle 5 - Reihen/4 Durchläufe (5, 4, 3, 2)
F99   ; 78           SHR     ZAEHL
F99   ; 79           SHR     ZAEHL
F89   ; 7A           INV     ZAEHL            15 - Reihen/4
7A9   ; 7B           SUBI    #A,ZAEHL         5 - Reihen/4

15F   ; 7C  FallA    MOVI    #5,AKT           fallen

F7F   ; 7D  Los      MAS     AKT              AKT über MF in den Kontext A
F0E   ; 7E           EXRM                     Kontext A, weiter mit Zug

BA5   ; 7F  Zug      CALL    Neg              Stein löschen: minus Masken addieren
BC3   ; 80           CALL    Acc

B8E   ; 81  ZugM     CALL    Mod              Aktion ausführen (fallen/hoch springen direkt nach Setzen)
BAA   ; 82           CALL    Masken
D8B   ; 83           BRC     Rand             über den Rand

BC3   ; 84  Setzen   CALL    Acc              Stein addieren; MASKE, ALT = alte Zeilen
2BD   ; 85           AND     UNTEN,MASKE      Treffer = alte Zeile UND Maske
2CE   ; 86           AND     OBEN,ALT
ADE   ; 87           OR      MASKE,ALT
E44   ; 88           BRZ     Fertig

BA5   ; 89  Kolli    CALL    Neg              Treffer: Stein wieder löschen ...
BC3   ; 8A           CALL    Acc
F8F   ; 8B  Rand     INV     AKT              ... Gegenaktion 5 - AKT (auch über den Rand)
7AF   ; 8C           SUBI    #A,AKT
C81   ; 8D           GOTO    ZugM


92F   ; 8E  Mod      CMPI    #2,AKT
D95   ; 8F           BRC     M345
E9C   ; 90           BRZ     MRe
0FF   ; 91           MOV     AKT,AKT
EA1   ; 92           BRZ     MHoch

719   ; 93  MLi      SUBI    #1,SPALTE        1: links
F07   ; 94           RET

94F   ; 95  M345     CMPI    #4,AKT
DA2   ; 96           BRC     MFall
E9F   ; 97           BRZ     MRechts

FA8   ; 98  MLd      SHL     FORM             3: links drehen = 3 mal rechts drehen
FB8   ; 99           ADC     FORM
FA8   ; 9A           SHL     FORM
FB8   ; 9B           ADC     FORM

FA8   ; 9C  MRe      SHL     FORM             2: rechts drehen
FB8   ; 9D           ADC     FORM
F07   ; 9E           RET

519   ; 9F  MRechts  ADDI    #1,SPALTE        4: rechts
F07   ; A0           RET

52A   ; A1  MHoch    ADDI    #2,ZEILE         0: hoch (Fallen zurücknehmen): +2, dann -1

71A   ; A2  MFall    SUBI    #1,ZEILE         5: fallen
BA5   ; A3           CALL    Neg              Masken bleiben, wieder positiv
C84   ; A4           GOTO    Setzen

F8B   ; A5  Neg      INV     UNTEN            Masken negieren (0 - Maske)
51B   ; A6           ADDI    #1,UNTEN
F8C   ; A7           INV     OBEN
51C   ; A8           ADDI    #1,OBEN
F07   ; A9           RET

08C   ; AA  Masken   MOV     FORM,OBEN        oben: Bit 1-2
33C   ; AB           ANDI    #3,OBEN
08B   ; AC           MOV     FORM,UNTEN       unten: Bit 4 (rechts) -> 2, Bit 8 (links) -> 1
34B   ; AD           ANDI    #4,UNTEN
F9B   ; AE           SHR     UNTEN
978   ; AF           CMPI    #7,FORM
FBB   ; B0           ADC     UNTEN
0CD   ; B1           MOV     OBEN,MASKE       Vereinigung prüft den Rand
ABD   ; B2           OR      UNTEN,MASKE
09E   ; B3           MOV     SPALTE,ALT
71E   ; B4           SUBI    #1,ALT
DBD   ; B5           BRC     MsLi             Spalte 0: eine nach links

71E   ; B6  MsL      SUBI    #1,ALT           SPALTE-1 mal nach rechts
DC1   ; B7           BRC     MsOk
FAD   ; B8           SHL     MASKE
DC2   ; B9           BRC     MsRet            rechter Rand
FAC   ; BA           SHL     OBEN
FAB   ; BB           SHL     UNTEN
CB6   ; BC           GOTO    MsL

F9D   ; BD  MsLi     SHR     MASKE
DC2   ; BE           BRC     MsRet            linker Rand
F9C   ; BF           SHR     OBEN
F9B   ; C0           SHR     UNTEN

F0A   ; C1  MsOk     RSC

F07   ; C2  MsRet    RET

93A   ; C3  Acc      CMPI    #3,ZEILE
DDD   ; C4           BRC     A47
91A   ; C5           CMPI    #1,ZEILE
DD1   ; C6           BRC     A23
ECC   ; C7           BRZ     A1

1FD   ; C8  A0       MOVI    #F,MASKE         untere Zeile = Boden
00E   ; C9           MOV     r0,ALT
4C0   ; CA           ADD     OBEN,r0
F07   ; CB           RET

00D   ; CC  A1       MOV     r0,MASKE
4B0   ; CD           ADD     UNTEN,r0
01E   ; CE           MOV     r1,ALT
4C1   ; CF           ADD     OBEN,r1
F07   ; D0           RET

92A   ; D1  A23      CMPI    #2,ZEILE
ED8   ; D2           BRZ     A2

02D   ; D3  A3       MOV     r2,MASKE
4B2   ; D4           ADD     UNTEN,r2
03E   ; D5           MOV     r3,ALT
4C3   ; D6           ADD     OBEN,r3
F07   ; D7           RET

01D   ; D8  A2       MOV     r1,MASKE
4B1   ; D9           ADD     UNTEN,r1
02E   ; DA           MOV     r2,ALT
4C2   ; DB           ADD     OBEN,r2
F07   ; DC           RET

95A   ; DD  A47      CMPI    #5,ZEILE
DEA   ; DE           BRC     A6
EE5   ; DF           BRZ     A5

03D   ; E0  A4       MOV     r3,MASKE
4B3   ; E1           ADD     UNTEN,r3
04E   ; E2           MOV     r4,ALT
4C4   ; E3           ADD     OBEN,r4
F07   ; E4           RET

04D   ; E5  A5       MOV     r4,MASKE
4B4   ; E6           ADD     UNTEN,r4
05E   ; E7           MOV     r5,ALT
4C5   ; E8           ADD     OBEN,r5
F07   ; E9           RET

97A   ; EA  A6       CMPI    #7,ZEILE
DF7   ; EB           BRC     A8
EF2   ; EC           BRZ     A7

05D   ; ED  A6L      MOV     r5,MASKE
4B5   ; EE           ADD     UNTEN,r5
06E   ; EF           MOV     r6,ALT
4C6   ; F0           ADD     OBEN,r6
F07   ; F1           RET

06D   ; F2  A7       MOV     r6,MASKE
4B6   ; F3           ADD     UNTEN,r6
07E   ; F4           MOV     r7,ALT
4C7   ; F5           ADD     OBEN,r7
F07   ; F6           RET

98A   ; F7  A8       CMPI    #8,ZEILE
EFB   ; F8           BRZ     A8L

1FE   ; F9  AB       MOVI    #F,ALT           ZEILE F: obere Zeile = Boden (die untere ist dann leer)
F07   ; FA           RET

07D   ; FB  A8L      MOV     r7,MASKE         untere Zeile = Reihe 8
4B7   ; FC           ADD     UNTEN,r7
10E   ; FD           MOVI    #0,ALT           obere Zeile: über dem Feld, frei
F07   ; FE           RET
