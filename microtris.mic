; microtris-06.mic - Tetris für Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio) und 4 Tastern
; 256 Schritte (00-FF), frei: 0
; Version 06: Matrix des ESP2090 Studios. Zwischen den Bildern schlaeft sie (ACK 15, kein REQ), damit Eingang 1
;   Taster links sein kann; vor dem Bild weckt F, dann folgt sofort ACK 1. Die Taster werden im Befehl
;   zwischen ACK und erstem Wert gelesen. Kolli faellt in Rand (1 Schritt gespart).
; Start: Reset, Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), RUN.
;   Alle Register müssen 0 sein. Matrix vergessen? Das Programm wartet am Anfang ohne Bild: Matrix einschalten.
; Tempo aus den gelöschten Reihen: der Stein fällt alle 5 - Reihen/4 Durchläufe,
;   0-3 Reihen 2,5 s je Reihe, 4-7 2,1 s, 8-11 1,75 s, 12-15 1,4 s, ab 16 jeden Durchlauf 1,0 s.
; Taster 1 (Pfeil links) = links, 4 (Pfeil rechts) = rechts,
;   2 (Pfeil hoch) = rechts drehen, 3 (Pfeil runter) = links drehen.
;   Nur neu gedrückte Taster zählen (einmal drücken = ein Schritt), mehrere: der niedrigste zählt.
; Schacht: Spalte 1-4, Reihe 1-8. Vorschau: der nächste Stein in Spalte 6-7, Reihe 7-8 (MD, MF).
;   Er fährt in Spalte 2-3 von oben ein: erst steht nur seine untere Zeile in Reihe 8 (ME),
;   die obere ist noch über dem Feld; beim nächsten Fallen ist er ganz drin.
; Formen im 2x2-Kasten: Ecke (1/2), Zweier (1/4), Quadrat (1/4), zufällig gedreht.
; Volle Reihen 1-7 verschwinden. Spielende, wenn nach dem Landen etwas in Reihe 8 liegt:
;   Anzeige = gelöschte Reihen dezimal. Neues Spiel: Reset.
; Zeiten: Durchlauf ohne Taste 0,38 s, Fallen +0,6 s, Zug oder Drehen +0,6 bis 0,9 s.
; Die Matrix ist nur für das Bild wach, sonst schlaeft sie: Eingang 1 ist dann Taster links.
;
; Feld: R0-R7 = Reihe 1-8 (unten nach oben), Bit 1 = Spalte 1 (links). Der Stein ist im Feld eingezeichnet.
; Zwei Kontexte in R8-RF, Wechsel mit EXRM (der andere liegt in M8-MF).
; AKT wird mit MAS übergeben; die neue Vorschau kommt per MAS UNTEN, MAS OBEN direkt nach VOR_U, VOR_O,
;   die alte obere Vorschauzeile per MAS VOR_O nach OBEN.
;
; #define (Register)
;   FORM      r8  Kontext A: Form im 2x2-Kasten, Bit 1 oben links, 2 oben rechts, 4 unten rechts, 8 unten links
;   SPALTE    r9  Kontext A: Kasten-Spalte 0-4 (linke Kastenspalte = Spalte SPALTE, 0 = über den linken Rand)
;   ZEILE     rA  Kontext A: obere Kastenzeile als Register 0-7 (untere = ZEILE-1; F und 8-E = unter dem Boden)
;   UNTEN     rB  Kontext A: Maske untere Kastenzeile (Spalte 1-4 = Bit 1-4)
;   OBEN      rC  Kontext A: Maske obere Kastenzeile
;   MASKE     rD  Kontext A: Hilfsregister: Summand für Zug, Vereinigung in Masken, RND-Ziffer D
;   ALT       rE  Kontext A: Hilfsregister: alte Zeile aus Zug, Zähler in Masken, RND-Ziffer E
;   AKT       rF  beide Kontexte: Aktion 0 hoch, 1 links, 2 rechts drehen, 3 links drehen, 4 rechts, 5 fallen
;   TASTE     r8  Kontext B: Taster bei der letzten Abfrage
;   ZAEHL     r9  Kontext B: Fallzähler, Unterlauf = fallen
;   HILF      rA  Kontext B: Hilfsregister: Matrix (Bereit, Start, Umschalten), neue Taster, Prüfung
;   VOR_U     rB  Kontext B: Vorschau = untere Zeile des nächsten Steins (Bit 2-4), gleiche Nummer wie UNTEN
;   VOR_O     rC  Kontext B: Vorschau = obere Zeile des nächsten Steins, gleiche Nummer wie OBEN
;   REIHEN_L  rD  Kontext B: gelöschte Reihen, Einer (hex)
;   REIHEN_H  rE  Kontext B: gelöschte Reihen, Sechzehner

F02   ; 00  Beginn   DISOUT                   Anzeige aus: 9,3 ms je Befehl (Takt der Matrix)
BF8   ; 01           CALL    Schlaf           Matrix schlafen (nach LED Start ist sie wach): Eingang 1 frei

9F0   ; 02  Voll     CMPI    #F,r0            Reihe 1 voll?
E15   ; 03           BRZ     Weg0
9F1   ; 04           CMPI    #F,r1
E16   ; 05           BRZ     Weg1
9F2   ; 06           CMPI    #F,r2
E17   ; 07           BRZ     Weg2
9F3   ; 08           CMPI    #F,r3
E18   ; 09           BRZ     Weg3
9F4   ; 0A           CMPI    #F,r4
E19   ; 0B           BRZ     Weg4
9F5   ; 0C           CMPI    #F,r5
E1A   ; 0D           BRZ     Weg5
9F6   ; 0E           CMPI    #F,r6
E1B   ; 0F           BRZ     Weg6

077   ; 10  Pruef    MOV     r7,r7            Reihe 8 leer? sonst Spielende
E21   ; 11           BRZ     Neu

F03   ; 12  Ende     HXDZ                     Spielende: gelöschte Reihen dezimal (AKT = F ist 0: gelandet)
F3D   ; 13           DISP    #3,REIHEN_L

C14   ; 14  Halt     GOTO    Halt             bleibt stehen (neues Spiel: Reset)

010   ; 15  Weg0     MOV     r1,r0            Reihe löschen: alles darüber eine Reihe tiefer

021   ; 16  Weg1     MOV     r2,r1

032   ; 17  Weg2     MOV     r3,r2

043   ; 18  Weg3     MOV     r4,r3

054   ; 19  Weg4     MOV     r5,r4

065   ; 1A  Weg5     MOV     r6,r5

076   ; 1B  Weg6     MOV     r7,r6

107   ; 1C  Weg7     MOVI    #0,r7
51D   ; 1D           ADDI    #1,REIHEN_L      Reihen zählen
FBE   ; 1E           ADC     REIHEN_H
C02   ; 1F           GOTO    Voll             weitere volle Reihe?

F0E   ; 20  Neu0     EXRM                     Spielbeginn: Kontext B, noch einmal

F7C   ; 21  Neu      MAS     VOR_O            obere Vorschauzeile nach MC = OBEN im Kontext A
4B7   ; 22           ADD     VOR_U,r7         untere Vorschauzeile in Reihe 8, Spalte 2-3 (Reihe 8 ist leer)
F0E   ; 23           EXRM                     Kontext A
0CA   ; 24           MOV     OBEN,ZEILE       obere Zeile merken (ZEILE ist frei)
F05   ; 25           RND                      Würfel in MASKE, ALT, AKT
178   ; 26           MOVI    #7,FORM          Ecke (1/2)
F9D   ; 27           SHR     MASKE
D2D   ; 28           BRC     Dreh
138   ; 29           MOVI    #3,FORM          Zweier (1/4)
F9D   ; 2A           SHR     MASKE
D2D   ; 2B           BRC     Dreh
1F8   ; 2C           MOVI    #F,FORM          Quadrat (1/4)

33E   ; 2D  Dreh     ANDI    #3,ALT           zufällig 0-3 mal drehen

71E   ; 2E  DrL      SUBI    #1,ALT
D33   ; 2F           BRC     DrE
FA8   ; 30           SHL     FORM
FB8   ; 31           ADC     FORM
C2E   ; 32           GOTO    DrL

129   ; 33  DrE      MOVI    #2,SPALTE        Masken in Spalte 2-3 = neue Vorschau
BA3   ; 34           CALL    Masken
F7B   ; 35           MAS     UNTEN            nach MB = VOR_U im Kontext B
F7C   ; 36           MAS     OBEN             nach MC = VOR_O
07B   ; 37           MOV     r7,UNTEN         aktueller Stein = alte Vorschau
0AC   ; 38           MOV     ZEILE,OBEN
0C8   ; 39           MOV     OBEN,FORM        FORM aus den Masken: oben Bit 2/4 -> 1/2
F98   ; 3A           SHR     FORM
0BD   ; 3B           MOV     UNTEN,MASKE      unten rechts (Bit 4) -> 4
34D   ; 3C           ANDI    #4,MASKE
AD8   ; 3D           OR      MASKE,FORM
0BD   ; 3E           MOV     UNTEN,MASKE      unten links (Bit 2) -> 8
FAD   ; 3F           SHL     MASKE
FAD   ; 40           SHL     MASKE
AD8   ; 41           OR      MASKE,FORM
E20   ; 42           BRZ     Neu0             leer: Spielbeginn ohne Vorschau
18A   ; 43           MOVI    #8,ZEILE         obere Kastenzeile über Reihe 8 (unsichtbar)
15F   ; 44           MOVI    #5,AKT           nicht 0 (0 = gelandet)
C55   ; 45           GOTO    Fertig           untere Zeile steht schon im Feld

B9E   ; 46  Zug      CALL    Neg              Stein löschen: minus Masken addieren
BBC   ; 47           CALL    Acc

B87   ; 48  ZugM     CALL    Mod              Aktion ausführen (fallen/hoch springen direkt nach Setzen)
BA3   ; 49           CALL    Masken
D52   ; 4A           BRC     Rand             über den Rand

BBC   ; 4B  Setzen   CALL    Acc              Stein addieren; MASKE, ALT = alte Zeilen
2BD   ; 4C           AND     UNTEN,MASKE      Treffer = alte Zeile UND Maske
2CE   ; 4D           AND     OBEN,ALT
ADE   ; 4E           OR      MASKE,ALT
E55   ; 4F           BRZ     Fertig

B9E   ; 50  Kolli    CALL    Neg              Treffer: Stein wieder löschen ...
BBC   ; 51           CALL    Acc
F8F   ; 52  Rand     INV     AKT              ... Gegenaktion 5 - AKT (auch über den Rand)
7AF   ; 53           SUBI    #A,AKT
C48   ; 54           GOTO    ZugM

F7F   ; 55  Fertig   MAS     AKT              AKT über MF in den Kontext B
F0E   ; 56           EXRM                     Kontext B
0FF   ; 57           MOV     AKT,AKT          0 = Fallen wurde zurückgenommen: gelandet
E02   ; 58           BRZ     Voll

719   ; 59  Grav     SUBI    #1,ZAEHL         Fallzähler (auch direkt nach dem Fallen): bei Unterlauf fallen
D7B   ; 5A           BRC     Fall

BFB   ; 5B  Bild     CALL    Tog              Matrix wecken (F, dann 0): der ESP setzt sofort REQ; HILF = 0

11F   ; 5C           MOVI    #1,AKT           ACK 1 = Blockmodus (REQ steht nach dem Wecken)
FEF   ; 5D           DOT     AKT              ACK 1
FDF   ; 5E           DIN     AKT              Taster: der eine Befehl zwischen ACK und erstem Wert (REQ ist jetzt Low)
FE0   ; 5F           DOT     r0               Reihe 1 links
FEA   ; 60           DOT     HILF             Reihe 1 rechts: dunkel
FE1   ; 61           DOT     r1               Reihe 2 links
FEA   ; 62           DOT     HILF             Reihe 2 rechts: dunkel
FE2   ; 63           DOT     r2               Reihe 3 links
FEA   ; 64           DOT     HILF             Reihe 3 rechts: dunkel
FE3   ; 65           DOT     r3               Reihe 4 links
FEA   ; 66           DOT     HILF             Reihe 4 rechts: dunkel
FE4   ; 67           DOT     r4               Reihe 5 links
FEA   ; 68           DOT     HILF             Reihe 5 rechts: dunkel
FE5   ; 69           DOT     r5               Reihe 6 links
FEA   ; 6A           DOT     HILF             Reihe 6 rechts: dunkel
FE6   ; 6B           DOT     r6               Reihe 7 links
FEB   ; 6C           DOT     VOR_U            Reihe 7 rechts: Vorschau unten
FE7   ; 6D           DOT     r7               Reihe 8 links
FEC   ; 6E           DOT     VOR_O            Reihe 8 rechts: Vorschau oben
FEA   ; 6F           DOT     HILF             Ausgaenge 0: Uebertragung fertig
BF8   ; 70           CALL    Schlaf           Matrix schlafen
08A   ; 71           MOV     TASTE,HILF       nur neu gedrückte Taster zählen
F8A   ; 72           INV     HILF
0F8   ; 73           MOV     AKT,TASTE
2FA   ; 74           AND     AKT,HILF
E59   ; 75           BRZ     Grav
10F   ; 76           MOVI    #0,AKT           AKT = Nummer des niedrigsten neuen Tasters

51F   ; 77  TNr      ADDI    #1,AKT
F9A   ; 78           SHR     HILF
D84   ; 79           BRC     Los
C77   ; 7A           GOTO    TNr

119   ; 7B  Fall     MOVI    #1,ZAEHL         Tempo: ab 16 Reihen jeden Durchlauf fallen ...
90E   ; 7C           CMPI    #0,REIHEN_H
D83   ; 7D           BRC     FallA
0D9   ; 7E           MOV     REIHEN_L,ZAEHL   ... sonst alle 5 - Reihen/4 Durchläufe (5, 4, 3, 2)
F99   ; 7F           SHR     ZAEHL
F99   ; 80           SHR     ZAEHL
F89   ; 81           INV     ZAEHL            15 - Reihen/4
7A9   ; 82           SUBI    #A,ZAEHL         5 - Reihen/4

15F   ; 83  FallA    MOVI    #5,AKT           fallen

F7F   ; 84  Los      MAS     AKT              AKT über MF in den Kontext A
F0E   ; 85           EXRM
C46   ; 86           GOTO    Zug


92F   ; 87  Mod      CMPI    #2,AKT
D8E   ; 88           BRC     M345
E95   ; 89           BRZ     MRe
0FF   ; 8A           MOV     AKT,AKT
E9A   ; 8B           BRZ     MHoch

719   ; 8C  MLi      SUBI    #1,SPALTE        1: links
F07   ; 8D           RET

94F   ; 8E  M345     CMPI    #4,AKT
D9B   ; 8F           BRC     MFall
E98   ; 90           BRZ     MRechts

FA8   ; 91  MLd      SHL     FORM             3: links drehen = 3 mal rechts drehen
FB8   ; 92           ADC     FORM
FA8   ; 93           SHL     FORM
FB8   ; 94           ADC     FORM

FA8   ; 95  MRe      SHL     FORM             2: rechts drehen
FB8   ; 96           ADC     FORM
F07   ; 97           RET

519   ; 98  MRechts  ADDI    #1,SPALTE        4: rechts
F07   ; 99           RET

52A   ; 9A  MHoch    ADDI    #2,ZEILE         0: hoch (Fallen zurücknehmen): +2, dann -1

71A   ; 9B  MFall    SUBI    #1,ZEILE         5: fallen
B9E   ; 9C           CALL    Neg              Masken bleiben, wieder positiv
C4B   ; 9D           GOTO    Setzen

F8B   ; 9E  Neg      INV     UNTEN            Masken negieren (0 - Maske)
51B   ; 9F           ADDI    #1,UNTEN
F8C   ; A0           INV     OBEN
51C   ; A1           ADDI    #1,OBEN
F07   ; A2           RET

08C   ; A3  Masken   MOV     FORM,OBEN        oben: Bit 1-2
33C   ; A4           ANDI    #3,OBEN
08B   ; A5           MOV     FORM,UNTEN       unten: Bit 4 (rechts) -> 2, Bit 8 (links) -> 1
34B   ; A6           ANDI    #4,UNTEN
F9B   ; A7           SHR     UNTEN
978   ; A8           CMPI    #7,FORM
FBB   ; A9           ADC     UNTEN
0CD   ; AA           MOV     OBEN,MASKE       Vereinigung prüft den Rand
ABD   ; AB           OR      UNTEN,MASKE
09E   ; AC           MOV     SPALTE,ALT
71E   ; AD           SUBI    #1,ALT
DB6   ; AE           BRC     MsLi             Spalte 0: eine nach links

71E   ; AF  MsL      SUBI    #1,ALT           SPALTE-1 mal nach rechts
DBA   ; B0           BRC     MsOk
FAD   ; B1           SHL     MASKE
DBB   ; B2           BRC     MsRet            rechter Rand
FAC   ; B3           SHL     OBEN
FAB   ; B4           SHL     UNTEN
CAF   ; B5           GOTO    MsL

F9D   ; B6  MsLi     SHR     MASKE
DBB   ; B7           BRC     MsRet            linker Rand
F9C   ; B8           SHR     OBEN
F9B   ; B9           SHR     UNTEN

F0A   ; BA  MsOk     RSC

F07   ; BB  MsRet    RET

93A   ; BC  Acc      CMPI    #3,ZEILE
DD6   ; BD           BRC     A47
91A   ; BE           CMPI    #1,ZEILE
DCA   ; BF           BRC     A23
EC5   ; C0           BRZ     A1

1FD   ; C1  A0       MOVI    #F,MASKE         untere Zeile = Boden
00E   ; C2           MOV     r0,ALT
4C0   ; C3           ADD     OBEN,r0
F07   ; C4           RET

00D   ; C5  A1       MOV     r0,MASKE
4B0   ; C6           ADD     UNTEN,r0
01E   ; C7           MOV     r1,ALT
4C1   ; C8           ADD     OBEN,r1
F07   ; C9           RET

92A   ; CA  A23      CMPI    #2,ZEILE
ED1   ; CB           BRZ     A2

02D   ; CC  A3       MOV     r2,MASKE
4B2   ; CD           ADD     UNTEN,r2
03E   ; CE           MOV     r3,ALT
4C3   ; CF           ADD     OBEN,r3
F07   ; D0           RET

01D   ; D1  A2       MOV     r1,MASKE
4B1   ; D2           ADD     UNTEN,r1
02E   ; D3           MOV     r2,ALT
4C2   ; D4           ADD     OBEN,r2
F07   ; D5           RET

95A   ; D6  A47      CMPI    #5,ZEILE
DE3   ; D7           BRC     A6
EDE   ; D8           BRZ     A5

03D   ; D9  A4       MOV     r3,MASKE
4B3   ; DA           ADD     UNTEN,r3
04E   ; DB           MOV     r4,ALT
4C4   ; DC           ADD     OBEN,r4
F07   ; DD           RET

04D   ; DE  A5       MOV     r4,MASKE
4B4   ; DF           ADD     UNTEN,r4
05E   ; E0           MOV     r5,ALT
4C5   ; E1           ADD     OBEN,r5
F07   ; E2           RET

97A   ; E3  A6       CMPI    #7,ZEILE
DF0   ; E4           BRC     A8
EEB   ; E5           BRZ     A7

05D   ; E6  A6L      MOV     r5,MASKE
4B5   ; E7           ADD     UNTEN,r5
06E   ; E8           MOV     r6,ALT
4C6   ; E9           ADD     OBEN,r6
F07   ; EA           RET

06D   ; EB  A7       MOV     r6,MASKE
4B6   ; EC           ADD     UNTEN,r6
07E   ; ED           MOV     r7,ALT
4C7   ; EE           ADD     OBEN,r7
F07   ; EF           RET

98A   ; F0  A8       CMPI    #8,ZEILE
EF4   ; F1           BRZ     A8L

1FE   ; F2  AB       MOVI    #F,ALT           ZEILE F: obere Zeile = Boden (die untere ist dann leer)
F07   ; F3           RET

07D   ; F4  A8L      MOV     r7,MASKE         untere Zeile = Reihe 8
4B7   ; F5           ADD     UNTEN,r7
10E   ; F6           MOVI    #0,ALT           obere Zeile: über dem Feld, frei
F07   ; F7           RET

FDA   ; F8  Schlaf   DIN     HILF             Matrix schlafen legen: auf REQ (Eingang 1) warten ...
31A   ; F9           ANDI    #1,HILF
EF8   ; FA           BRZ     Schlaf
1FA   ; FB  Tog      MOVI    #F,HILF          ... ACK 15 (schlafen); Einsprung Tog: F weckt die Matrix
FEA   ; FC           DOT     HILF
10A   ; FD           MOVI    #0,HILF          Ausgaenge 0: nach dem Schlafen kann F wieder wecken,
FEA   ; FE           DOT     HILF             nach dem Wecken gilt das naechste ACK (HILF = 0 fuers Bild)
F07   ; FF           RET
